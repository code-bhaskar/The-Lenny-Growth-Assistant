# Application
APP_NAME=The Lenny Growth Assistant
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/lenny_growth
ALLOW_SQLITE_FOR_TESTS=true

# Model selection
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_AUTO_PULL=true
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud fallback / optional Anthropic agent path
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ENABLE_CLAUDE_AGENT_SDK=false
CLAUDE_AGENT_SDK_MODEL=claude-sonnet-4-5

# Knowledge base
INGEST_ON_STARTUP=true
TRANSCRIPT_REPO_URL=https://codeload.github.com/ChatPRD/lennys-podcast-transcripts/zip/refs/heads/main
TRANSCRIPT_CACHE_DIR=/app/data/raw/lennys-podcast-transcripts
TRANSCRIPT_FIXTURE_DIR=/app/data/samples
PROCESSED_INDEX_PATH=/app/data/processed/tfidf_index.joblib
PROCESSED_MANIFEST_PATH=/app/data/processed/chunks.json
MAX_CHUNKS_PER_ANSWER=6
RETRIEVAL_SCORE_THRESHOLD=0.08
RETRIEVAL_CHUNK_SIZE=1800
RETRIEVAL_CHUNK_OVERLAP=250

# UI / artifacts
FRONTEND_ORIGIN=http://localhost:8000
ARTIFACT_MAX_CHARS=40000
DEFAULT_USER_NAME=Evaluator
REQUEST_TIMEOUT_SECONDS=180
