APP_NAME=The Lenny Growth Assistant
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/lenny_growth
ALLOW_SQLITE_FOR_TESTS=true

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_AUTO_PULL=true
OLLAMA_CONTEXT_WINDOW=32768

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com

PI_AGENT_BACKEND=node
PI_AGENT_THINKING_LEVEL=medium
PI_AGENT_TEMPERATURE=0.2
PI_AGENT_MAX_TOKENS=4000

INGEST_ON_STARTUP=true
TRANSCRIPT_REPO_URL=https://codeload.github.com/ChatPRD/lennys-podcast-transcripts/zip/refs/heads/main
TRANSCRIPT_CACHE_DIR=/app/data/raw/lennys-podcast-transcripts
TRANSCRIPT_FIXTURE_DIR=/app/data/samples
MAX_CHUNKS_PER_ANSWER=6
RETRIEVAL_SCORE_THRESHOLD=0.08
RETRIEVAL_CHUNK_SIZE=1800
RETRIEVAL_CHUNK_OVERLAP=250

FRONTEND_ORIGIN=http://localhost:3000
ARTIFACT_MAX_CHARS=40000
DEFAULT_USER_NAME=Evaluator
REQUEST_TIMEOUT_SECONDS=180
